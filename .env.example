# ─────────────────────────────────────────────────────────────────────────────
#  ZAVORA Marketplace — Production Environment Configuration (.env.example)
#  John Luka Media (JLM) Digital Ecosystem
#  Copy this file to .env and configure your production credentials.
#  NEVER commit the real .env to public version control.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_ENV=production
APP_DEBUG=false
ZAVORA_SITE_URL=https://zavora.com.ng

# Database (MySQL for Production / cPanel / VPS)
ZAVORA_DB_HOST=localhost
ZAVORA_DB_PORT=3306
ZAVORA_DB_NAME=gwylvxeo_zavora
ZAVORA_DB_USER=gwylvxeo_zavora
ZAVORA_DB_PASS=CHANGE_ME_PRODUCTION_DB_PASS

# Paystack Payment Gateway (Live Keys)
PAYSTACK_PUBLIC_KEY=pk_live_YOUR_PAYSTACK_PUBLIC_KEY_HERE
PAYSTACK_SECRET_KEY=sk_live_YOUR_PAYSTACK_SECRET_KEY_HERE

# JLM Unified Digital Ecosystem Inter-Service Integration
ECOSYSTEM_API_SECRET=eco_sec_YOUR_SHARED_ECOSYSTEM_SECRET_KEY
LEARNERIUM_URL=https://learnerium.jlm.com.ng
JLM_CORPORATE_URL=https://jlm.com.ng
LMS_URL=https://lms.jlm.com.ng

# Marketplace Commission Settings (Default: 15% platform commission, 85% vendor payout)
ZAVORA_COMMISSION_PERCENT=15
